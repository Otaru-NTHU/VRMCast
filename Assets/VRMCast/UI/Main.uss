:root {
    --bg: rgb(30, 30, 34);
    --bg-panel: rgb(38, 38, 43);
    --bg-field: rgb(52, 52, 58);
    --border: rgb(60, 60, 66);
    --text: rgb(228, 228, 232);
    --text-dim: rgb(150, 150, 158);
    --accent: rgb(84, 140, 240);
    --accent-hover: rgb(110, 160, 250);
    --danger: rgb(240, 96, 96);
    --ok: rgb(96, 200, 120);
}

/* Bundled Noto Sans TC (SIL OFL) so Traditional Chinese renders in the editor and in builds. */
.app, .modal-overlay {
    -unity-font-definition: url("Fonts/NotoSansTC-Regular.otf");
}

.app {
    flex-grow: 1;
    background-color: var(--bg);
    color: var(--text);
    font-size: 12px;
}

.header {
    flex-direction: row;
    align-items: center;
    height: 36px;
    padding-left: 12px;
    padding-right: 12px;
    background-color: var(--bg-panel);
    border-bottom-width: 1px;
    border-bottom-color: var(--border);
}

.header-title {
    font-size: 15px;
    -unity-font-style: bold;
    margin-right: 10px;
}

.header-subtitle {
    color: var(--text-dim);
}

.header-profile {
    color: var(--text-dim);
    margin-right: 12px;
}

.header-language {
    width: 190px;
    margin: 0;
}

.header-language > Label {
    min-width: 0;
    margin-right: 6px;
    color: var(--text-dim);
}

.spacer {
    flex-grow: 1;
}

.body {
    flex-direction: row;
    flex-grow: 1;
}

.sidebar {
    width: 290px;
    min-width: 290px;
    background-color: var(--bg-panel);
    border-right-width: 1px;
    border-right-color: var(--border);
}

.section {
    padding: 10px 12px 12px 12px;
    border-bottom-width: 1px;
    border-bottom-color: var(--border);
}

.section-title {
    font-size: 10px;
    letter-spacing: 1px;
    color: var(--text-dim);
    margin-bottom: 6px;
    -unity-font-style: bold;
}

.model-name {
    font-size: 13px;
    -unity-font-style: bold;
    white-space: normal;
}

.model-status {
    color: var(--text-dim);
    white-space: normal;
    margin-bottom: 6px;
}

.row {
    flex-direction: row;
    align-items: center;
    margin-top: 2px;
    margin-bottom: 2px;
}

.row-right {
    justify-content: flex-end;
}

.grow {
    flex-grow: 1;
}

.hint {
    color: var(--text-dim);
    font-size: 10px;
    white-space: normal;
    margin-top: 4px;
}

.diag {
    color: var(--text-dim);
    margin-bottom: 2px;
}

.value-label {
    width: 34px;
    -unity-text-align: middle-right;
}

.field-label {
    width: 60px;
}

.swatch {
    width: 22px;
    height: 22px;
    margin-left: 4px;
    border-radius: 3px;
    border-width: 1px;
    border-color: var(--border);
}

.advanced-box {
    margin-top: 6px;
    padding: 6px;
    border-width: 1px;
    border-color: var(--border);
    border-radius: 4px;
}

.advanced-title {
    color: var(--text-dim);
    margin-bottom: 4px;
}

.error-text {
    color: var(--danger);
}

.preview-area {
    flex-grow: 1;
    background-color: rgb(16, 16, 18);
    justify-content: center;
    align-items: center;
}

.preview {
    flex-grow: 1;
    width: 100%;
    height: 100%;
}

.message-banner {
    position: absolute;
    top: 12px;
    left: 12px;
    right: 12px;
    padding: 6px 10px;
    border-radius: 4px;
    background-color: rgba(40, 90, 60, 0.92);
    color: white;
    white-space: normal;
}

.message-banner.error {
    background-color: rgba(140, 40, 40, 0.92);
}

.status-bar {
    flex-direction: row;
    align-items: center;
    height: 34px;
    padding-left: 12px;
    padding-right: 8px;
    background-color: var(--bg-panel);
    border-top-width: 1px;
    border-top-color: var(--border);
}

.status-item {
    margin-right: 14px;
}

.status-dim {
    color: var(--text-dim);
}

/* Controls */

Button {
    background-color: var(--bg-field);
    border-color: var(--border);
    border-radius: 4px;
    color: var(--text);
    padding: 4px 10px;
    margin: 2px;
}

Button:hover {
    background-color: rgb(66, 66, 74);
}

Button:disabled {
    opacity: 0.5;
}

Button.primary {
    background-color: var(--accent);
    border-color: var(--accent);
    color: white;
    -unity-font-style: bold;
}

Button.primary:hover {
    background-color: var(--accent-hover);
}

Button.running {
    background-color: var(--danger);
    border-color: var(--danger);
}

DropdownField, TextField, Slider {
    margin: 2px;
}

DropdownField > Label, TextField > Label, Slider > Label {
    min-width: 60px;
    color: var(--text-dim);
}

.unity-base-field__input {
    background-color: var(--bg-field);
    border-color: var(--border);
    border-radius: 4px;
    color: var(--text);
}

.unity-base-popup-field__text {
    color: var(--text);
}

/* Modal file picker */

.modal-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.55);
    justify-content: center;
    align-items: center;
}

.modal-dialog {
    width: 640px;
    height: 480px;
    background-color: var(--bg-panel);
    border-width: 1px;
    border-color: var(--border);
    border-radius: 6px;
    padding: 12px;
}

.modal-title {
    font-size: 14px;
    -unity-font-style: bold;
    margin-bottom: 6px;
}

#file-picker-list {
    flex-grow: 1;
    margin-top: 6px;
    margin-bottom: 6px;
    background-color: var(--bg);
    border-width: 1px;
    border-color: var(--border);
    border-radius: 4px;
}

#file-picker-list .unity-collection-view__item,
#file-picker-list .unity-list-view__item {
    padding-left: 4px;
    padding-right: 4px;
}

#file-picker-list .unity-collection-view__item:hover,
#file-picker-list .unity-list-view__item:hover {
    background-color: rgb(58, 58, 66);
}

#file-picker-list .unity-collection-view__item--selected,
#file-picker-list .unity-list-view__item--selected,
#file-picker-list .unity-collection-view__item:checked,
#file-picker-list .unity-list-view__item:checked {
    background-color: var(--accent);
}

.file-entry {
    padding-left: 6px;
    -unity-text-align: middle-left;
    color: var(--text);
    font-size: 13px;
}

.file-entry-dir {
    color: rgb(150, 190, 255);
    -unity-font-style: bold;
}

#file-picker-path {
    margin-bottom: 4px;
}

#file-picker-path .unity-base-field__input,
#file-picker-path .unity-text-element {
    color: var(--text);
    font-size: 13px;
}

#file-picker-error {
    min-height: 16px;
}
