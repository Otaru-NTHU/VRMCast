<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="Main.uss" />
    <ui:VisualElement name="app" class="app">
        <ui:VisualElement name="header" class="header">
            <ui:Label text="VRMCast" class="header-title" />
            <ui:Label name="header-subtitle" text="" class="header-subtitle" />
            <ui:VisualElement class="spacer" />
            <ui:DropdownField name="profile-select" label="" class="header-profile-select" />
            <ui:Button name="profile-manage" text="" class="header-button" />
            <ui:Button name="performance-mode" text="" class="header-button" />
            <ui:DropdownField name="language" label="" class="header-language" />
        </ui:VisualElement>
        <ui:VisualElement name="body" class="body">
            <ui:ScrollView name="sidebar" class="sidebar" mode="Vertical">
                <ui:VisualElement class="section">
                    <ui:Label name="section-model" text="" class="section-title" />
                    <ui:Label name="model-name" text="No avatar loaded" class="model-name" />
                    <ui:Label name="model-status" text="Load a .vrm file to begin." class="model-status" />
                    <ui:VisualElement class="row">
                        <ui:Button name="load-vrm" text="Load VRM" class="primary grow" />
                        <ui:Button name="unload-vrm" text="Unload" />
                    </ui:VisualElement>
                    <ui:VisualElement name="import-advanced" class="advanced-box">
                        <ui:Label name="import-title" text="" class="advanced-title" />
                        <ui:DropdownField name="import-version" label="VRM Version" />
                        <ui:Button name="retry-load" text="Retry with this version" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement class="section">
                    <ui:Label name="section-camera" text="" class="section-title" />
                    <ui:VisualElement class="row">
                        <ui:DropdownField name="camera-device" label="" class="grow" />
                        <ui:Button name="camera-refresh" text="↻" class="icon-button" />
                    </ui:VisualElement>
                    <ui:VisualElement name="camera-preview-box" class="camera-preview-box">
                        <ui:Image name="camera-preview" class="camera-preview" />
                        <ui:Label name="camera-state" text="" class="camera-state" />
                    </ui:VisualElement>
                    <ui:Toggle name="camera-mirror" label="" value="true" />
                </ui:VisualElement>

                <ui:VisualElement class="section">
                    <ui:Label name="section-tracking" text="" class="section-title" />
                    <ui:Label name="tracking-setup-hint" text="" class="hint warning-text" />
                    <ui:VisualElement class="row">
                        <ui:Button name="tracking-toggle" text="" class="primary grow" />
                        <ui:Button name="calibrate" text="" class="grow" />
                    </ui:VisualElement>
                    <ui:Label name="tracking-status" text="" class="tracking-status" />
                    <ui:DropdownField name="tracking-mode" label="" />
                    <ui:Foldout name="tracking-advanced" text="" value="false" class="advanced-foldout">
                        <ui:Toggle name="mirror-user" label="" value="true" />
                        <ui:VisualElement class="row">
                            <ui:Slider name="track-smoothing" label="" low-value="0" high-value="1" value="0.5" class="grow" />
                            <ui:Label name="track-smoothing-value" text="" class="value-label" />
                        </ui:VisualElement>
                        <ui:VisualElement class="row">
                            <ui:Slider name="track-gain" label="" low-value="0.2" high-value="2.5" value="1" class="grow" />
                            <ui:Label name="track-gain-value" text="" class="value-label" />
                        </ui:VisualElement>
                        <ui:VisualElement class="row">
                            <ui:Slider name="track-blink" label="" low-value="0.5" high-value="4" value="1.8" class="grow" />
                            <ui:Label name="track-blink-value" text="" class="value-label" />
                        </ui:VisualElement>
                        <ui:VisualElement class="row">
                        </ui:VisualElement>
                        <ui:Button name="clear-calibration" text="" />
                    </ui:Foldout>
                </ui:VisualElement>

                <ui:VisualElement class="section">
                    <ui:Label name="section-lipsync" text="" class="section-title" />
                    <ui:DropdownField name="lipsync-mode" label="" />
                    <ui:VisualElement name="mic-rows">
                        <ui:VisualElement class="row">
                            <ui:DropdownField name="mic-device" label="" class="grow" />
                            <ui:Button name="mic-refresh" text="↻" class="icon-button" />
                        </ui:VisualElement>
                        <ui:VisualElement class="row">
                            <ui:Label name="mic-level-label" text="" class="field-label" />
                            <ui:VisualElement name="mic-level" class="level-meter grow">
                                <ui:VisualElement name="mic-level-fill" class="level-meter-fill" />
                                <ui:VisualElement name="mic-gate-mark" class="level-meter-gate" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:Label name="mic-state" text="" class="hint" />
                        <ui:VisualElement class="row">
                            <ui:Slider name="mic-sensitivity" label="" low-value="0.2" high-value="4" value="1" class="grow" />
                            <ui:Label name="mic-sensitivity-value" text="" class="value-label" />
                        </ui:VisualElement>
                        <ui:VisualElement class="row">
                            <ui:Slider name="mic-gate" label="" low-value="-80" high-value="-20" value="-45" class="grow" />
                            <ui:Label name="mic-gate-value" text="" class="value-label" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement class="section">
                    <ui:Label name="section-body" text="" class="section-title" />
                    <ui:DropdownField name="body-mode" label="" />
                    <ui:Label name="hands-state" text="" class="hint" />
                    <ui:Toggle name="arms-from-hands" label="" value="true" />
                    <ui:Toggle name="wrist-from-palm" label="" value="false" />
                    <ui:Label name="body-hint" text="" class="hint" />
                </ui:VisualElement>

                <ui:VisualElement class="section">
                    <ui:Label name="section-hotkeys" text="" class="section-title" />
                    <ui:VisualElement name="hotkey-rows" />
                    <ui:Label name="hotkey-hint" text="" class="hint" />
                </ui:VisualElement>

                <ui:VisualElement class="section">
                    <ui:Label name="section-framing" text="" class="section-title" />
                    <ui:DropdownField name="framing-preset" label="Preset" />
                    <ui:VisualElement class="row">
                        <ui:Slider name="zoom" label="" low-value="0.25" high-value="4" value="1" class="grow" />
                        <ui:Label name="zoom-value" text="1.0×" class="value-label" />
                    </ui:VisualElement>
                    <ui:VisualElement class="row">
                        <ui:Slider name="fov" label="FOV" low-value="10" high-value="90" value="30" class="grow" />
                        <ui:Label name="fov-value" text="30°" class="value-label" />
                    </ui:VisualElement>
                    <ui:VisualElement class="row">
                        <ui:Button name="reset-camera" text="Reset Camera" class="grow" />
                        <ui:Button name="reset-orientation" text="Reset Orientation" class="grow" />
                    </ui:VisualElement>
                    <ui:Button name="reframe" text="Reframe to Avatar" />
                    <ui:Label name="framing-hint" text="" class="hint" />
                </ui:VisualElement>

                <ui:VisualElement class="section">
                    <ui:Label name="section-background" text="" class="section-title" />
                    <ui:DropdownField name="background-mode" label="Mode" />
                    <ui:VisualElement name="color-row" class="row">
                        <ui:Label name="color-label" text="Key color" class="field-label" />
                        <ui:TextField name="color-hex" value="#00FF00" class="grow" />
                        <ui:VisualElement name="color-swatch" class="swatch" />
                    </ui:VisualElement>
                    <ui:VisualElement name="image-rows">
                        <ui:VisualElement class="row">
                            <ui:Button name="choose-image" text="Choose Image…" class="grow" />
                            <ui:Button name="clear-image" text="Clear" />
                        </ui:VisualElement>
                        <ui:Label name="image-name" text="No image selected" class="hint" />
                        <ui:DropdownField name="image-fit" label="Fit" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement class="section">
                    <ui:Label name="section-output" text="" class="section-title" />
                    <ui:DropdownField name="output-quality" label="Quality" />
                    <ui:Label name="vcam-title" text="" class="subsection-title" />
                    <ui:Label name="vcam-status" text="" />
                    <ui:VisualElement class="row">
                        <ui:Button name="vcam-install" text="" />
                        <ui:Button name="vcam-uninstall" text="" />
                    </ui:VisualElement>
                    <ui:Label name="vcam-hint" text="" class="hint" />
                    <ui:Label name="output-hint" text="" class="hint" />
                </ui:VisualElement>

                <ui:VisualElement class="section">
                    <ui:Label name="section-diagnostics" text="" class="section-title" />
                    <ui:Label name="diag-fps" text="Render: – fps" class="diag" />
                    <ui:Label name="diag-output" text="Output: –" class="diag" />
                    <ui:Label name="diag-avatar" text="Avatar: (none)" class="diag" />
                    <ui:Label name="diag-tracking" text="" class="diag" />
                    <ui:Label name="diag-pose" text="" class="diag" />
                    <ui:Label name="diag-hands" text="" class="diag" />
                    <ui:Button name="copy-diagnostics" text="Copy Diagnostics" />
                </ui:VisualElement>
            </ui:ScrollView>

            <ui:VisualElement name="preview-area" class="preview-area">
                <ui:Image name="preview" class="preview" />
                <ui:Label name="message-banner" text="" class="message-banner" />
                <ui:Label name="perf-overlay" text="" class="perf-overlay" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="status-bar" class="status-bar">
            <ui:Label name="status-resolution" text="1920×1080 | 30 FPS" class="status-item" />
            <ui:Label name="status-render-fps" text="Render – fps" class="status-item" />
            <ui:Label name="status-face" text="" class="status-item status-dim" />
            <ui:Label name="status-audio" text="" class="status-item status-dim" />
            <ui:Label name="status-output" text="Output: off" class="status-item" />
            <ui:VisualElement class="spacer" />
            <ui:Button name="toggle-output" text="Start Output" class="primary" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
